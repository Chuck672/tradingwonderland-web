# .env.example
# Path to the SQLite database file. Defaults to market_data.db in the project root.
SQLITE_DB_PATH=

# Public site origin used for Stripe success/cancel URLs.
# Production should be https://quantlogiclab.com with no port.
NEXT_PUBLIC_SITE_URL=https://quantlogiclab.com

# Stripe — overseas checkout for PiTradingAgent Setup 8.0.0.
# Paste these in Hostinger → website dashboard → Environment variables.
# Never commit live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Hosted Checkout does not read this. Set it only if you add Stripe.js later.
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# One-time USD Prices created in the Stripe Dashboard.
STRIPE_PRICE_149=
STRIPE_PRICE_349=

# Optional. Used only when the matching Price ID above is missing.
# Must be an https://buy.stripe.com/... Payment Link.
STRIPE_PAYMENT_LINK_149=
STRIPE_PAYMENT_LINK_349=

# Optional. Where paid orders are emailed. The webhook still writes the plan and
# license code when SMTP is unset. Falls back to SMTP_USER.
# Existing SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS are reused.
ORDER_NOTIFY_EMAIL=

# PiTradingAgent installer. The file is not in git.
# Preferred: private GitHub release asset. The server exchanges the token for a
# short-lived download URL. Never put a github.com browse URL here.
GITHUB_TOKEN=
GITHUB_RELEASE_ASSET_URL=
# Used only when GITHUB_TOKEN + GITHUB_RELEASE_ASSET_URL are not both set.
# https object-storage URL. github.com pages are rejected.
PITRADINGAGENT_DOWNLOAD_URL=
# Optional Content-Disposition filename. Default PiTradingAgent-Setup.zip.
PITRADINGAGENT_DOWNLOAD_FILENAME=

# Exclusive MT5 tools (.ex5) on /api/tools/download.
# Reuses GITHUB_TOKEN. Remote lookup runs only when the tag below is set.
# The server GETs /repos/{owner}/{repo}/releases/tags/{tag} and downloads the
# asset whose name is exactly the tool filename. On a miss or GitHub error it
# falls back to private-tools/<filename>.ex5 in the repo. Do not commit tokens.
# Optional. Defaults to Chuck672/PiTradingAgentV8.
GITHUB_TOOLS_REPO=
# Required for the remote path. Example: mt5-ex5
# Release asset names, exact:
# SVP5_pro.ex5
# inRangeVP.ex5
# scalpTradingPanel.ex5
# strengthBubble_pro.ex5
# Trend_Panel9_pro.ex5
# microOrderFlow.ex5
GITHUB_TOOLS_RELEASE_TAG=
